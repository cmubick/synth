<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The synth's dark panel behind everything, full screen, drawn into the camera
         cutout too (the walnut side panels fill it, as on iPhone). -->
    <style name="Theme.Synth" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/panel</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
